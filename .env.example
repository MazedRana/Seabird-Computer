# Copy this file to `.env` and fill values before running locally.
# Do NOT commit the real `.env` file to version control.

# Resend email service API key (server-side only)
RESEND_API_KEY=your_resend_api_key_here

# Optional sender override used by serverless function
SENDER_EMAIL=onboarding@resend.dev

# Supabase (client-side) - use VITE_ prefix for Vite env variables used in browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Example: SITE_URL used for canonical and sitemap submission
SITE_URL=https://seabirdisp.com
